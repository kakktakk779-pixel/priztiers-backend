@echo off
chcp 65001 > nul
title PrizTiers Bot Manager

:: Переходим в папку, где лежит сам start.bat
cd /d "%~dp0"

echo ===================================================
echo    Запуск PrizTiers Bot, Flask и Ngrok
echo ===================================================

:: 1. Автоматически запускаем ngrok в отдельном окне
start "" ngrok http 5000

:: Ждем 3 секунды, чтобы ngrok и Flask успели инициализироваться
timeout /t 3 > nul

:: 2. Автоматически открываем браузер с локальным сайтом
start http://localhost:5000

:loop
echo [%DATE% %TIME%] Запуск бота...
:: Замените tierlist_bot.py на ваше имя файла, если оно отличается
python tierlist_bot.py

echo.
echo ===================================================
echo ❌ БОТ ОСТАНОВИЛСЯ ИЛИ УПАЛ С ОШИБКОЙ!
echo Изучите ошибку выше. 
echo Перезапуск через 5 секунд (или закройте окно / нажмите Ctrl+C)...
echo ===================================================

timeout /t 5 > nul
cls
goto loop